{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./packages/typescript-config/base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@repo/*": ["./packages/*/src", "./packages/*"]
    },
    "composite": true,
    "declaration": true,
    "declarationMap": true
  },
  "files": [],
  "references": [
    {
      "path": "./packages/typescript-config"
    },
    {
      "path": "./packages/eslint-config"
    },
    {
      "path": "./apps/sample-web"
    },
    {
      "path": "./apps/sample-api"
    }
  ],
  "include": [],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    ".next",
    ".turbo",
    "coverage"
  ]
}